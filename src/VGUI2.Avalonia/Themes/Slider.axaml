<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:vgui2="using:VGUI2.Avalonia.Controls">

  <ResourceDictionary.MergedDictionaries>
    <ResourceInclude Source="avares://VGUI2.Avalonia/Themes/Palette.axaml" />
  </ResourceDictionary.MergedDictionaries>

  <!--
    VGUI2.css: .vgui-slider — 40px tall; an 18px track row holding a 4px
    inset bar and a 6px raised thumb, a 5px tick scale and a caption row.
  -->
  <ControlTheme x:Key="{x:Type vgui2:VguiSlider}" TargetType="vgui2:VguiSlider">
    <Setter Property="Foreground" Value="{DynamicResource VguiBrushText}" />
    <Setter Property="FontFamily" Value="{DynamicResource VguiFontFamily}" />
    <Setter Property="FontSize" Value="{DynamicResource VguiFontSize}" />
    <Setter Property="Width" Value="180" />
    <Setter Property="Height" Value="{DynamicResource VguiSliderHeight}" />
    <Setter Property="Template">
      <ControlTemplate>
        <Grid RowDefinitions="17,5,18">
          <Panel x:Name="PART_TrackArea" Background="Transparent">
            <!-- .vgui-slider-track-bar.vgui-theme-inner — recessed groove
                 (dark top/left edges, light bottom/right) -->
            <vgui2:VguiFrame Height="4"
                                VerticalAlignment="Top"
                                Margin="10,7,10,0"
                                FrameStyle="Inset"
                                Background="{DynamicResource VguiBrushBgDark}"
                                EdgeLightBrush="{DynamicResource VguiBrushBorderLight}"
                                EdgeDarkBrush="{DynamicResource VguiBrushBorderDark}" />
            <Thumb x:Name="PART_Thumb"
                   Width="6"
                   Height="16"
                   VerticalAlignment="Top"
                   HorizontalAlignment="Left"
                   Cursor="Hand"
                   Focusable="False">
              <Thumb.Template>
                <ControlTemplate>
                  <vgui2:VguiFrame FrameStyle="Raised"
                                      Background="{DynamicResource VguiBrushBg}"
                                      EdgeLightBrush="{DynamicResource VguiBrushBorderLight}"
                                      EdgeDarkBrush="{DynamicResource VguiBrushBorderDark}" />
                </ControlTemplate>
              </Thumb.Template>
            </Thumb>
          </Panel>

          <!-- VGUI2.css: .vgui-slider-scale — 13px periodic ticks -->
          <Border Grid.Row="1"
                  Height="5"
                  Margin="7,0,9,0"
                  BorderThickness="1,0"
                  BorderBrush="{StaticResource VguiBrushTextDim}"
                  Background="{StaticResource VguiTickBrush}" />

          <Grid Grid.Row="2" IsVisible="{TemplateBinding ShowCaptions}">
            <TextBlock x:Name="PART_MinCaption"
                       HorizontalAlignment="Left"
                       VerticalAlignment="Top"
                       FontSize="{DynamicResource VguiFontSizeSmall}"
                       Foreground="{DynamicResource VguiBrushTextDim}" />
            <TextBlock x:Name="PART_MaxCaption"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Top"
                       FontSize="{DynamicResource VguiFontSizeSmall}"
                       Foreground="{DynamicResource VguiBrushTextDim}" />
          </Grid>
        </Grid>
      </ControlTemplate>
    </Setter>
  </ControlTheme>

</ResourceDictionary>
